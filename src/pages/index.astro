---
import { getCollection } from "astro:content";
import Layout from "../layouts/layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectMosaic from "../components/ProjectMosaic.astro";

const base = import.meta.env.BASE_URL;

  // The mosaic needs enough projects to look full. Until then, show cards.
  const MOSAIC_MIN = 6;
  const MOSAIC_MAX = 13;

  const allFeatured = (
      await getCollection(
          "projects",
          ({ data }) => !data.draft && data.featured,
      )
  ).sort((a, b) => b.data.year - a.data.year);

  const useMosaic = allFeatured.length >= MOSAIC_MIN;
  const featured = allFeatured.slice(0, useMosaic ? MOSAIC_MAX : 3);
  
---

<Layout>
    <section class="hero">
        <p class="eyebrow">Senior Graphic Designer · Creative Technologist</p>

        <h1>
            I design things,
            <br />
            then I figure out
            <br />
            how to make them work.
        </h1>

        <p class="hero-intro">
            I'm Gabby, a senior graphic designer exploring the space where
            design, code and AI meet.
        </p>

        <div class="hero-actions">
        <a href={`${base}work/`}>View my work</a>
        <a href={`${base}ai/`}>Explore AI + Code</a>
        </div>
    </section>

    {
        featured.length > 0 && (
            <section class="featured" aria-labelledby="featured-heading">
                <div class="section-header">
                    <h2 id="featured-heading">Selected projects</h2>
                    <a href={`${base}work/`}>View all work →</a>
                </div>

            {
                      useMosaic ? (
                          <ProjectMosaic projects={featured} />
                      ) : (
                          <div class="project-grid">
                              {featured.map((project) => (
                                  <ProjectCard project={project} headingLevel="h3" />
                              ))}
                          </div>
                      )
                  }
            </section>
        )
    }
</Layout>