---
import Layout from "../layouts/layout.astro";

const base = import.meta.env.BASE_URL;
---

<Layout>
    <section class="hero">
        <p class="eyebrow">Senior Graphic Designer · Creative Technologist</p>

        <h1>
            I design things,
            <br />
            then I figure out
            <br />
            how to make them work.
        </h1>

        <p class="hero-intro">
            I'm Gabby, a senior graphic designer exploring the space where
            design, code and AI meet.
        </p>

        <div class="hero-actions">
        <a href={`${base}work/`}>View my work</a>
        <a href={`${base}ai/`}>Explore AI + Code</a>
        </div>
    </section>
</Layout>