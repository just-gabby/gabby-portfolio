---
import { getCollection } from "astro:content";
import Layout from "../../layouts/layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = (
    await getCollection(
        "projects",
        ({ data }) => !data.draft && data.category !== "design",
    )
).sort((a, b) => b.data.year - a.data.year);
---

<Layout
    title="AI + Code | Gabby"
    description="AI, Python and creative technology projects by Gabriele Naseviciute."
>
    <section class="page-intro">
        <p class="eyebrow">AI + Code</p>

        <h1>Learning by building.</h1>

        <p>
            Projects exploring Python, AI, automation and the intersection
            between technology and creative work.
        </p>
    </section>

    {
        projects.length > 0 ? (
            <section class="project-grid" aria-label="Projects">
                {projects.map((project) => (
                    <ProjectCard project={project} />
                ))}
            </section>
        ) : (
            <p class="empty-state">Projects coming soon.</p>
        )
    }
</Layout>