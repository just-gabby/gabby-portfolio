---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/layout.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects", ({ data }) => !data.draft);

    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { title, summary, year, category, gallery } = project.data;
const { Content } = await render(project);

const base = import.meta.env.BASE_URL;

const categoryLabels = {
    design: "Graphic design",
    "creative-tech": "Creative tech",
    "ai-code": "AI + Code",
};
---

<Layout title={`${title} | Gabby`} description={summary}>
    <section class="page-intro">
        <p class="eyebrow">{categoryLabels[category]} · {year}</p>
        <h1>{title}</h1>
        <p>{summary}</p>
    </section>

    {
        gallery.length > 0 && (
            <section class="project-gallery" aria-label="Project images">
                {gallery.map((item) => (
                    <figure>
                        <Image src={item.src} alt={item.alt} width={1600} />
                        {item.caption && <figcaption>{item.caption}</figcaption>}
                    </figure>
                ))}
            </section>
        )
    }

    <div class="project-body">
        <Content />
    </div>

    <p class="project-back">
        <a href={`${base}work/`}>← Back to work</a>
    </p>
</Layout>