---
import { getCollection } from "astro:content";
import Layout from "../../layouts/layout.astro";

const base = import.meta.env.BASE_URL;

const posts = (
    await getCollection("journal", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (date: Date) =>
    date.toLocaleDateString("en-GB", {
        day: "numeric",
        month: "long",
        year: "numeric",
        timeZone: "UTC",
    });
---

<Layout
    title="Journal | Gabby"
    description="Notes, experiments and things I'm learning about design, code and AI."
>
    <section class="page-intro">
        <p class="eyebrow">Journal</p>

        <h1>Things I'm learning, building and breaking.</h1>

        <p>
            Notes from the process of moving deeper into code, AI and creative
            technology.
        </p>
    </section>

    {
        posts.length > 0 ? (
            <ol class="journal-list" role="list">
                {posts.map((post) => (
                    <li class="journal-item">
                        <time
                            class="journal-date"
                            datetime={post.data.date.toISOString().slice(0, 10)}
                        >
                            {formatDate(post.data.date)}
                        </time>
                        <div>
                            <h2>
                                <a href={`${base}journal/${post.id}/`}>
                                    {post.data.title}
                                </a>
                            </h2>
                            <p>{post.data.summary}</p>
                        </div>
                    </li>
                ))}
            </ol>
        ) : (
            <p class="empty-state">First post coming soon.</p>
        )
    }
</Layout>