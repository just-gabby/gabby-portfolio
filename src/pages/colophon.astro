---
import Layout from "../layouts/layout.astro";

// Hex codes are copied from the top of global.css. The dark palette is
// written there twice, so keep both copies identical. If you change a
// colour there, change it here too.
const colours = [
    { name: "Background", light: "#f5f3ef", dark: "#141311", note: "Warm off-white, like uncoated stock. In dark, a warm near-black." },
    { name: "Surface", light: "#ebe7df", dark: "#1e1c19", note: "A step away from the background, for code blocks and placeholders." },
    { name: "Text", light: "#171717", dark: "#f1eee8", note: "Near-black in light, warm off-white in dark. About 16:1 on the background in both." },
    { name: "Muted", light: "#6b6862", dark: "#a8a39a", note: "Secondary text. About 5:1 in light and 7.4:1 in dark." },
    { name: "Accent", light: "#ff5a36", dark: "#ff5a36", note: "Pantone: close enough. Only about 2.8:1 on the light background, so there it is decoration and never small text. On dark it reaches 6:1." },
    { name: "Accent text", light: "#c2300f", dark: "#ff7d5e", note: "Coral for text and hover states: deeper in light, about 5:1, and lighter in dark, about 7.4:1." },
    { name: "Border", light: "#d5d0c7", dark: "#36332e", note: "Hairlines." },
];

const spacing = [
    { variable: "--space-xs", value: "0.5rem" },
    { variable: "--space-sm", value: "1rem" },
    { variable: "--space-md", value: "2rem" },
    { variable: "--space-lg", value: "4rem" },
    { variable: "--space-xl", value: "8rem" },
];
---

<Layout
    title="Colophon | Gabby"
    description="The type, colours and spacing behind this site, and how it is built."
>
    <section class="page-intro">
        <p class="eyebrow">Colophon</p>

        <h1>How this site is made.</h1>

        <p class="intro-tight">The type, the colours and the spacing, for anyone who likes to check.</p>
    </section>

    <div class="about-sections">
        <section class="about-section">
            <h2>Typography</h2>
            <div class="about-section-body about-section-body--wide">
                <div class="specimen-glyphs" aria-hidden="true">
                    <span class="specimen-serif">Aa</span>
                    <span class="specimen-sans">Aa</span>
                </div>

                <div class="specimens">
                    <div>
                        <h3>Newsreader</h3>
                        <p>
                            Headlines and titles, in regular and medium, with
                            italics. Free from Google Fonts and served from
                            this site.
                        </p>
                    </div>
                    <div>
                        <h3>Inter</h3>
                        <p>
                            Everything else, in regular, medium and semibold.
                            Also free, also served from this site.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section class="about-section">
            <h2>Colour</h2>
            <div class="about-section-body">
                <p style="margin-bottom: var(--space-sm)">
                    Each swatch is split: light on the left, dark on the right.
                </p>

                <ul class="swatches" role="list">
                    {
                        colours.map((colour) => (
                            <li class="swatch">
                                <span
                                    class="swatch-chip"
                                    style={`background: linear-gradient(90deg, ${colour.light} 50%, ${colour.dark} 50%)`}
                                    aria-hidden="true"
                                />
                                <div class="swatch-text">
                                    <p class="swatch-name">
                                        {colour.name}
                                        <span class="swatch-hex">
                                            {colour.light === colour.dark
                                                ? `${colour.light}, both themes`
                                                : `${colour.light} light, ${colour.dark} dark`}
                                        </span>
                                    </p>
                                    <p class="swatch-meta">{colour.note}</p>
                                </div>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </section>

        <section class="about-section">
            <h2>Spacing</h2>
            <div class="about-section-body">
                <p>
                    Every gap between blocks on this site comes from this
                    scale. 
                </p>

                                <p style="margin-top: var(--space-sm)">
                    The page sits on 12 columns (Shift+G shows them).
                    Paragraph widths are set for reading, not for the grid.
                </p>

                <ul class="spacing-scale" role="list">
                    {
                        spacing.map((step) => (
                            <li>
                                <span
                                    class="spacing-bar"
                                    style={`width: var(${step.variable})`}
                                    aria-hidden="true"
                                />
                                <span>{step.variable}, {step.value}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </section>

        <section class="about-section">
            <h2>Built with</h2>
            <div class="about-section-body">
                <ul class="about-list">
                    <li>Astro, with plain HTML and CSS.</li>
                    <li>
                        A little JavaScript: the logo, the timeline, the
                        theme switch, the grid overlay (Shift+G) and the
                        redlines (Shift+R).
                    </li>
                    <li>
                        Light and dark themes. The site follows your system
                        until you flip the switch in the header.
                    </li>
                    <li>Hosted on GitHub Pages and deployed with GitHub Actions.</li>
                    <li>
                        <a href="https://github.com/just-gabby/gabby-portfolio">The source is on GitHub</a>.
                    </li>
                </ul>
            </div>
        </section>
    </div>
</Layout>