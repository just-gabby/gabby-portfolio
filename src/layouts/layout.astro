---
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from "../components/header.astro";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Gabby | Graphic Designer & Creative Technologist",
    description = "Portfolio of Gabriele Naseviciute, a senior graphic designer and creative technologist.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <Font cssVariable="--font-newsreader" />
        <Font cssVariable="--font-inter" />

        <title>{title}</title>

        <meta
            name="description"
            content={description}
        />
    </head>

    <body>
        <a class="skip-link" href="#main">Skip to content</a>
        <Header />
        <main id="main" tabindex="-1">
            <slot />
        </main>
    </body>
</html>