---
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Gabby | Graphic Designer & Creative Technologist",
    description = "Portfolio of Gabriele Naseviciute, a senior graphic designer and creative technologist.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og-image.png`, Astro.site);
const isHome = Astro.url.pathname === base;
const person = {
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Gabriele Naseviciute",
      alternateName: "Gabby",
      jobTitle: "Senior Graphic Designer and Creative Technologist",
      url: new URL(base, Astro.site).href,
      sameAs: [
          "https://www.linkedin.com/in/gnaseviciute/",
          "https://github.com/just-gabby",
      ],
  };
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#f5f3ef" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />
         <script is:inline>
             try {
                var stored = localStorage.getItem("theme");
                if (stored === "light" || stored === "dark") {
                    document.documentElement.dataset.theme = stored;
                 }
              } catch (e) {}
          </script>
        <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
        <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
        <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
        <Font cssVariable="--font-newsreader" />
        <Font cssVariable="--font-inter" />
        <Font cssVariable="--font-typewriter" />

        <title>{title}</title>

        <meta
            name="description"
            content={description}
        />
        <link rel="canonical" href={canonical} />
        {isHome && <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />}

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Gabby" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Gabby, graphic designer and creative technologist" />
        <meta name="twitter:card" content="summary_large_image" />
    </head>

    <body>
        <!--
            Hello, person viewing the source.
            I've build this with Astro, half of the time not knowing what I'm doing.
            Hope you've enjoyed this little Easter egg.
        -->
        <a class="skip-link" href="#main">Skip to content</a>
        <Header />
        <main id="main" tabindex="-1">
            <slot />
        </main>
        <Footer />

        <div class="grid-overlay" aria-hidden="true">
            <div class="grid-overlay-inner">
                {Array.from({ length: 12 }, () => <span />)}
            </div>
        </div>

          <script>
            import "../scripts/redline.ts";
            import "../scripts/theme.ts";

            console.log(
                "%cHello, curious one.",
                "font: 24px Georgia, serif; color: #ff5a36;",
            );
            console.log("I'm Gabby. I design things, then I figure out how to make them work.");
            console.log("Press Shift+G on the page to see the grid, and Shift+R for the redlines.");

            document.addEventListener("keydown", (event) => {
                if (event.ctrlKey || event.metaKey || event.altKey) return;
                if (!event.shiftKey || event.key.toLowerCase() !== "g") return;

                const target = event.target as HTMLElement;
                if (target.matches("input, textarea, select, [contenteditable]")) return;

                document.body.classList.toggle("show-grid");
            });
        </script>
    </body>
</html>