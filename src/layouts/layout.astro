---
import "../styles/global.css";
import Header from "../components/header.astro";

const {
    title = "Gabby | Graphic Designer & Creative Technologist",
    description = "Portfolio of Gabriele Naseviciute."
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <title>{title}</title>

        <meta
            name="description"
            content={description}
        />
    </head>

   <body>
    <Header />

    <slot />
    </body>
</html>